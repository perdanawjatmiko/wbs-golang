# Copy to .env.docker; edit privately. Never commit credentials.
# Compose: docker compose --env-file .env.docker ...
# Existing database only: macOS host uses host.docker.internal; VM uses private DNS/IP.
# 127.0.0.1 would refer to the application container, not your PostgreSQL host.
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@host.docker.internal:5432/REPLACE_APPROVED_DEV_DATABASE?sslmode=disable
APP_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_CONNECT_TIMEOUT=5s
DB_QUERY_TIMEOUT=5s
DB_READY_TIMEOUT=2s
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
HTTP_SHUTDOWN_TIMEOUT=15s
APP_TIMEZONE=Asia/Jakarta
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_MAX_REQUEST_BYTES=6291456
# Compose forcibly disables provider delivery for local QA.
SMTP_ENABLED=false
TELEGRAM_ENABLED=false
NOTIFICATION_WORKER_ENABLED=true
# Bootstrap credentials are passed explicitly only to the one-off seed command.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m
RATE_LIMIT_BUCKETS=16384
RATE_LIMIT_TIMEOUT=1s
HTTP_TRUSTED_PROXY_CIDRS=
COOKIE_SECURE=false
NOTIFICATION_WORKER_DB_STARTUP_ATTEMPTS=5
NOTIFICATION_WORKER_DB_STARTUP_BACKOFF=1s
