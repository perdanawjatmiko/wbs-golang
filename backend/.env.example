# Development examples only. Export these values before running Go.
APP_NAME=wbs-backend
APP_ENV=local
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
DATABASE_URL=postgres://wbs_user:password@localhost:5432/wbs_db?sslmode=disable
DB_MAX_OPEN_CONNS=20
# pgxpool warm idle target (MinIdleConns), not a hard idle ceiling.
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_READY_TIMEOUT=2s
CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576

# Phase 1: bounded database operations and absolute session lifetime (1m..24h).
DB_QUERY_TIMEOUT=5s
SESSION_TTL=8h
# Bootstrap only: all three must be supplied to create an initial admin.
# No admin is created if these are empty; existing passwords are never overwritten.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# Phase 2: technical defaults; canonical contact quota is fixed by blueprint at 5.
APP_TIMEZONE=Asia/Jakarta
UPLOAD_DIR=./var/private/attachments
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_MAX_REQUEST_BYTES=6291456
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf
# 0 disables attachments; at most one attachment per report.
UPLOAD_MAX_FILES=1
REPORT_UPLOAD_CONCURRENCY=2
REPORT_REQUEST_TIMEOUT=10s
REPORT_SUBMIT_RATE_LIMIT=10
REPORT_TRACK_RATE_LIMIT=30
REPORT_RATE_WINDOW=15m

# Phase 4: optional providers. Disabled deliveries remain pending, attempts unchanged.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=WBS
# starttls or implicit; verified TLS is mandatory.
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=15s
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Numeric group chat ID, typically negative. Never publish bot credentials.
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=10s
# Dedicated command: go run ./cmd/worker (not spawned by the HTTP server).
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_BATCH_SIZE=25
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_POLL_INTERVAL=2s
NOTIFICATION_WORKER_LEASE_DURATION=60s
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_INTERVALS=30s,2m,10m,30m,2h
SSE_MAX_CONNECTIONS=100
SSE_REPLAY_LIMIT=100
SSE_POLL_INTERVAL=2s
SSE_HEARTBEAT_INTERVAL=15s
